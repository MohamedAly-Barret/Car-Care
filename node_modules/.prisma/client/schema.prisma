datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Organization {
  id        String     @id @default(uuid())
  name      String
  createdAt DateTime   @default(now()) @map("created_at")
  branches  Branch[]
  staff     Staff[]
  customers Customer[]

  @@map("organizations")
}

model Branch {
  id             String       @id @default(uuid())
  organizationId String       @map("organizations_id")
  name           String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  staff          Staff[]
  customers      Customer[]
  workOrders     WorkOrder[]

  @@map("branches")
}

model Staff {
  id               String            @id @default(uuid())
  branchId         String            @map("branch_id")
  organizationId   String            @map("organizations_id")
  name             String
  email            String            @unique
  phone            String
  role             String
  isActive         Boolean           @default(true) @map("is_active")
  branch           Branch            @relation(fields: [branchId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  organization     Organization      @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  workOrderDetails WorkOrderDetail[]
  invoiceDetails   InvoiceDetail[]

  @@map("staff")
}

model Customer {
  id              String           @id @default(uuid())
  branchId        String           @map("branch_id")
  organizationId  String           @map("organizations_id")
  name            String
  phone           String           @unique
  tempLoginCode   String?          @map("temp_login_code")
  codeExpiresAt   DateTime?        @map("code_expires_at")
  branch          Branch           @relation(fields: [branchId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  cars            Car[]
  workOrders      WorkOrder[]
  crmInteractions CRMInteraction[]

  @@map("customers")
}

model Car {
  id          String      @id @default(uuid())
  customerId  String      @map("customer_id")
  model       String
  plateNumber String      @unique @map("plate_number")
  year        Int
  customer    Customer    @relation(fields: [customerId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  workOrders  WorkOrder[]

  @@map("cars")
}

model WorkOrder {
  id                String @id @default(uuid())
  branchId          String @map("branch_id")
  customerId        String @map("customer_id")
  carId             String @map("car_id")
  customerComplaint String @map("customer_complaint")
  trackingCode      String @unique @map("tracking_code")
  status            String @default("Pending")

  branch   Branch   @relation(fields: [branchId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  car      Car      @relation(fields: [carId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  details         WorkOrderDetail[]
  crmInteractions CRMInteraction[]
  invoices        Invoice[]

  @@map("work_orders")
}

model WorkOrderDetail {
  id             String @id @default(uuid())
  workOrderId    String @map("work_order_id")
  technicianId   String @map("technician_id")
  title          String
  severity       String
  laborCost      Float  @map("labor_cost")
  approvalStatus String @default("Pending") @map("approval_status")

  workOrder  WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  technician Staff     @relation(fields: [technicianId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("work_order_details")
}

model CRMInteraction {
  id                 String   @id @default(uuid())
  customerId         String   @map("customer_id")
  workOrderId        String   @map("work_order_id")
  scheduledDate      DateTime @map("scheduled_data")
  type               String
  isClosed           Boolean  @default(false) @map("id_closed")
  satisfactionRating Int?     @map("satisafaction_rating")
  resultNotes        String?  @map("result_notes")

  customer  Customer  @relation(fields: [customerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  workOrder WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("crm_interactions")
}

model Invoice {
  id           String @id @default(uuid())
  workOrderId  String @map("work_order_id")
  serialNumber String @unique @map("serial_number")
  subtotal     Float
  discount     Float  @default(0)
  tax          Float  @default(0)
  total        Float
  status       String @default("Unpaid")

  workOrder WorkOrder       @relation(fields: [workOrderId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  details   InvoiceDetail[]

  @@map("invoices")
}

model InvoiceDetail {
  id           String   @id @default(uuid())
  invoiceId    String   @map("invoices_id")
  workOrderId  String   @map("work_order_id")
  accountantId String   @map("accountant_id")
  issuedAt     DateTime @default(now()) @map("issued_at")
  grandTotal   Float    @map("grand_total")
  notes        String?

  invoice    Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  accountant Staff   @relation(fields: [accountantId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("invoice_details")
}
